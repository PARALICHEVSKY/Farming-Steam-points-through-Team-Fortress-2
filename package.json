{
  "name": "farming-steam-points-through-tf2",
  "version": "1.0.0",
  "description": "Buy Mann Co. Supply Crate Keys in the TF2 store for Steam Points, then resell them on the Steam Community Market at the lowest ask while tracking the loss per key.",
  "type": "module",
  "main": "src/index.js",
  "bin": {
    "tf2-points": "src/index.js"
  },
  "scripts": {
    "start": "node src/index.js run",
    "run-cycle": "node src/index.js run",
    "buy": "node src/index.js buy",
    "sell": "node src/index.js sell",
    "confirm": "node src/index.js confirm",
    "price": "node src/index.js price",
    "stats": "node src/index.js stats",
    "dashboard": "node src/index.js dashboard",
    "test": "node --test test/*.test.js"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "dependencies": {
    "dotenv": "^16.4.5",
    "protobufjs": "^7.4.0",
    "steam-totp": "^2.1.2",
    "steam-user": "^5.2.0",
    "steamcommunity": "^3.48.3"
  }
}
