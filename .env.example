# Скопируйте в .env и заполните. Никогда не коммитьте .env!

# --- Аккаунт Steam ---
STEAM_ACCOUNT_NAME=
STEAM_PASSWORD=
# shared_secret и identity_secret из maFile (Steam Desktop Authenticator / SDA)
# shared_secret -> коды входа Steam Guard, identity_secret -> подтверждение лотов на ТП
STEAM_SHARED_SECRET=
STEAM_IDENTITY_SECRET=

# Необязательно: ключ Web API (https://steamcommunity.com/dev/apikey)
# нужен, чтобы автоматически узнать цену ключа в магазине TF2 в валюте кошелька
STEAM_API_KEY=

# --- Безопасность ---
# true = ничего не покупать и не выставлять, только показать, что было бы сделано
DRY_RUN=true
# Сколько ключей покупать за один цикл
KEYS_PER_CYCLE=1
# Сколько циклов делать за запуск команды run
CYCLES=1
# Максимальный допустимый убыток на ключ, % от цены магазина. Если рынок хуже, цикл пропускается.
MAX_LOSS_PERCENT=25
# Лимит трат в магазине за сутки, в минимальных единицах валюты (центы/копейки). 0 = без лимита
DAILY_SPEND_LIMIT=0
# Минимальная цена для покупателя (в минимальных единицах), ниже которой не выставлять. 0 = без ограничения
MIN_BUYER_PRICE=0
# Продавать только ключи, купленные этим скриптом (не трогать уже лежащие в инвентаре)
SELL_ONLY_PURCHASED=true

# --- Цены ---
# Цена ключа в магазине TF2 в минимальных единицах валюты кошелька (например 249 = $2.49).
# Если пусто и задан STEAM_API_KEY, цена берётся из ISteamEconomy/GetAssetPrices.
KEY_STORE_PRICE=
# На сколько минимальных единиц дешевле самого дешёвого лота выставлять (0 = ровно по минимальной цене)
UNDERCUT=0
# Комиссии ТП: Steam 5% + TF2 (издатель) 10%
STEAM_FEE_PERCENT=0.05
PUBLISHER_FEE_PERCENT=0.10
# Сколько очков Steam даётся за 1 основную единицу валюты кошелька (100 за $1). Для оценки.
POINTS_PER_UNIT=100

# --- Тайминги ---
# Сколько минут ждать появления купленных ключей в инвентаре (и снятия запрета на продажу)
INVENTORY_WAIT_MINUTES=10
# Пауза между циклами, секунды
CYCLE_DELAY_SECONDS=60
# Сколько минут ждать ручного подтверждения покупки, если автоматическое не сработало
MANUAL_APPROVE_WAIT_MINUTES=5

# --- Дашборд ---
DASHBOARD_PORT=3000
